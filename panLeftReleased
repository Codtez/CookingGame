////////////////////////////////////////////////////////////////////////////////////////////



//////////// PAN FOOD to Cook Display which SubSprite

switch (foodCounter)
{	
	default:
		vPanDisplay = 0;
	break;
	
	case vBaseFood:
		vPanDisplay = 8;
	break;
	
	case vBeef:
		vPanDisplay = 1;
	break;
	
	case vChick:
        vPanDisplay = 2;
    break;
	
	case vVeg:
        vPanDisplay = 3;
    break;

    case vBeefChick:
        vPanDisplay = 4;
    break;
	
	case vBeefVeg:
        vPanDisplay = 5;
    break;
	
	case vBeefChickVeg:
        vPanDisplay = 6;
    break;

	case vChickVeg:
        vPanDisplay = 7;
    break;
	
}
