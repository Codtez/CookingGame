/////////////////////// Raw Ingredients interact with Stove ////////////////////////////

//////////START WITH NOODLES - END WITH SAUCE
if (place_meeting(x,y,rawNoodlesDrop))
{
	if (Noodles_Pan == false)
	{
		audio_play_sound(Frying_Stove,1,false)
		foodCounter = 0;
		Noodles_Pan = true;
		
	}
	else
	{audio_play_sound(stop_13692,10,false)}
}
/////SauceDrop
if (place_meeting(x,y,sauceBottleDrop))
{
	if (Noodles_Pan == true)
	{
		audio_play_sound(FIRE_Stove,1,false);
		sprite_index = Stove_Burn_Anim;
				
		timer_Stove = time_source_create(time_source_game, 1.5, time_source_units_seconds, 
		function()
		{
			sprite_index = Stove_Idle; ////Reset Stove to Idle Sprite
			Noodles_Pan = false;   //// Reset all ingredient slots to empty
			hasBeef = false;
			hasChick = false;
			hasVeg = false;
			vPanDisplay = 0; //// Reset SubSprite of food in pan to empty sprite
			
			//Spawn Cooked Food and Reset FoodCounter
			switch (foodCounter)
			{
				case vRolls:
					array_push(CookedFoodArray.foodInventory,foodCounter)
				break;
				
				case vBaseFood:
					array_push(CookedFoodArray.foodInventory,foodCounter)
				break;
				
				case vBeef:
					array_push(CookedFoodArray.foodInventory,foodCounter)
				break;
				
				case vChick:
					array_push(CookedFoodArray.foodInventory,foodCounter)
				break;
				
				case vVeg:
					array_push(CookedFoodArray.foodInventory,foodCounter)
				break;

				case vBeefChick:
					array_push(CookedFoodArray.foodInventory,foodCounter)
				break;
				
				case vBeefVeg:
					array_push(CookedFoodArray.foodInventory,foodCounter)
				break;
				
				case vChickVeg:
					array_push(CookedFoodArray.foodInventory,foodCounter)
				break;
				
				case vBeefChickVeg:
					array_push(CookedFoodArray.foodInventory,foodCounter)
				break;
					
			}
			
			foodCounter = -1;

		}, [], 1);
		/////timer function^ timer start>
		time_source_start(timer_Stove);
		
	}
	else
	{audio_play_sound(stop_13692,10,false)}
}


