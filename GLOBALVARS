//////////////////////// food id to price function

function foodIDtoPrice(fID)
{
	switch(fID)
	{
		case vBaseFood:
			return pRecNoodles
		break;
		case vBeef:
			return pRecBeef
		break;
		case vChick:
			return pRecChick
		break;
		case vVeg:
			return pRecVeg
		break;	
		case vBeefChick:
			return pRecBeefChick
		break;
		case vBeefVeg:
			return pRecBeefVeg
		break;
		case vChickVeg:
			return pRecChickVeg
		break;
		case vBeefChickVeg:
			return pRecBeefChickVeg
		break;
		case vRolls:
			return pRecRolls
		break;
		default:
			return 0;
		break;
		
	}
}

///// Reciept Value to Color Scheme
function recToColors(Lvl)
{
	switch (Lvl)
	{
		case 0:
			GloRecColor = c_green;
			GloRecAccent = c_lime;
		break;
		
		case 1:
			GloRecColor = c_yellow;
			GloRecAccent = c_orange;
		break;
		
		case 2:
			GloRecColor = c_red;
			GloRecAccent = c_silver;
		break;
	}

}
